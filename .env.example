# Copier ce fichier en .env et remplir les valeurs

# Connexion PostgreSQL locale
DATABASE_URL=postgresql://postgres:MOTDEPASSE@localhost:5432/meteo_analyste

# Secret de session Express (generer une chaine aleatoire longue)
SESSION_SECRET=change_moi_avec_une_chaine_aleatoire_longue

# Ports (optionnel - modifier si les ports par defaut sont deja pris)
# Port du serveur API (defaut: 8090)
API_PORT=8090
# Port du frontend (defaut: 5173)
FRONTEND_PORT=5173

# Cle API Gemini (optionnel)
# GEMINI_API_KEY=
